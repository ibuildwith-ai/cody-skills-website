---
/**
 * Marketing landing — codyskills.ai/
 *
 * Pure Astro page outside Starlight's docs frame. Pulls every dynamic value
 * (skill names, versions, taglines, illustrations, status) from `src/skills`
 * via the discriminated-union `Skill` type. No content hardcoded except the
 * hero/marquee/footer copy.
 *
 * Layout:
 *   - MarketingHeader (custom topbar with brand + Skills dropdown + nav)
 *   - Hero: "Agent Skills / Created for Builders" + lead + single CTA
 *   - Marquee: "works with" label + list of supported AI agents
 *   - Skill rows: one per entry in `skills`, alternating illustration sides
 *   - Footer: 3-column (brand+copyright | Skills | Site)
 */
import { skills, availableSkills } from '../skills';
import MarketingHeader from '../components/MarketingHeader.astro';
import SkillCard from '../components/SkillCard.astro';
import { CONTACT_EMAIL, IBUILDWITH_AI_URL } from '../site-config';

const defaultSkill = availableSkills[0];
const getStartedHref = `/docs/${defaultSkill.id}/`;
const contactHref = `mailto:${CONTACT_EMAIL}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cody Skills · Agent Skills Created for Builders</title>
    <meta
      name="description"
      content="AI agent skills that help turn ideas into shipped products. Built for knowledge workers, domain experts, and creators."
    />
    <link rel="icon" type="image/png" href="/images/cody-skills-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap"
    />
  </head>
  <body>
    <MarketingHeader />

    <section class="hero">
      <div class="hero-inner">
        <h1>Agent Skills<br />Created for <span class="accent">Builders</span></h1>
        <p class="lead">
          AI agent skills that help turn ideas into shipped products. Built
          for knowledge workers, domain experts, and creators.
        </p>
        <div class="hero-ctas">
          <a href={getStartedHref} class="btn btn-primary">Get Started →</a>
        </div>
      </div>
    </section>

    <div class="marquee">
      <span class="m-label">works with</span>
      <span>Claude Code</span>·<span>Cursor</span>·<span>GitHub Copilot</span>·<span>Codex</span>·<span>Claude.ai</span>
    </div>

    <section class="skills" id="skills">
      <div class="skills-inner">
        {
          skills.map((skill, i) => (
            <SkillCard skill={skill} reverse={i % 2 === 1} />
          ))
        }
      </div>
    </section>

    <footer>
      <div class="foot-inner">
        <div>
          <div class="foot-brand">
            <img class="logo" src="/images/cody-skills-logo.png" alt="" />
            Cody Skills
          </div>
          <div class="foot-copy">© 2026 Red Pill Blue Pill Studios.</div>
        </div>

        <div>
          <div class="foot-col-label">Skills</div>
          {
            skills.map((s) =>
              s.status === 'available' ? (
                <a class="foot-col-link" href={`/docs/${s.id}/`}>
                  {s.name}
                </a>
              ) : (
                <span class="foot-col-link soon">{s.name}</span>
              )
            )
          }
        </div>

        <div>
          <div class="foot-col-label">Site</div>
          <a class="foot-col-link" href={getStartedHref}>Documentation</a>
          <a class="foot-col-link" href={contactHref}>Contact</a>
          <a
            class="foot-col-link"
            href={IBUILDWITH_AI_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            iBuildWith.ai
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Marketing-page color tokens. Scoped via `--cs-*` so they don't collide
   * with Starlight's `--sl-*` tokens inside the docs. These are also used by
   * MarketingHeader.astro and SkillCard.astro as fallbacks.
   */
  :root {
    --cs-bg: #0e0e0e;
    --cs-bg-2: #181818;
    --cs-bg-3: #1f1f1f;
    --cs-border: #2a2a2a;
    --cs-text: #e6e6e6;
    --cs-text-2: #b0b0b0;
    --cs-text-3: #888;
    --cs-accent: #22c55e;
    --cs-accent-2: #4ade80;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--cs-bg);
    color: var(--cs-text);
    line-height: 1.65;
    font-size: 15px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    /* Match Starlight (docs) so the brand text renders at the same visual
       weight on both surfaces. Without this, the marketing landing falls back
       to subpixel rendering, making DM Sans 700 look noticeably heavier. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>

<style>
  /* HERO — same shape as mockup 2 */
  .hero {
    position: relative;
    padding: 130px 24px 110px;
    text-align: center;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 1200px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(34, 197, 94, 0.18) 0%,
      rgba(34, 197, 94, 0) 55%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0,
      var(--cs-border) 30%,
      var(--cs-border) 70%,
      transparent 100%
    );
  }
  .hero-inner {
    max-width: 920px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  h1 {
    font-size: 72px;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: #fff;
    margin-bottom: 24px;
  }
  h1 .accent {
    background: linear-gradient(135deg, #22c55e 0%, #4ade80 50%, #86efac 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .lead {
    font-size: 19px;
    color: var(--cs-text-2);
    max-width: 640px;
    margin: 0 auto 36px;
    line-height: 1.55;
  }
  .hero-ctas {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 650;
    text-decoration: none;
    letter-spacing: 0.005em;
  }
  .btn-primary {
    background: var(--cs-accent);
    color: var(--cs-bg);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 10px 30px rgba(34, 197, 94, 0.25);
  }
  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  /* MARQUEE */
  .marquee {
    padding: 30px 24px;
    text-align: center;
    font-size: 12.5px;
    color: var(--cs-text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .marquee span {
    margin: 0 18px;
  }
  .marquee .m-label {
    display: block;
    text-align: center;
    color: var(--cs-accent-2);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    font-size: 12px;
    margin: 0 0 10px 0;
  }

  /* SKILLS section — gap between rows */
  .skills {
    padding: 70px 24px 90px;
  }
  .skills-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  /* FOOTER — 3-column grid */
  footer {
    margin-top: auto;
    border-top: 1px solid var(--cs-border);
    padding: 44px 24px 34px;
    background: #0a0a0a;
  }
  .foot-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: flex-start;
  }
  .foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    color: #fff;
    font-size: 14px;
    letter-spacing: -0.01em;
  }
  .foot-brand .logo {
    width: 22px;
    height: 22px;
    display: block;
    flex-shrink: 0;
  }
  .foot-copy {
    font-size: 12.5px;
    color: var(--cs-text-3);
    margin-top: 8px;
  }
  .foot-col-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cs-text-3);
    margin-bottom: 14px;
  }
  .foot-col-link {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--cs-text-2);
    text-decoration: none;
    padding: 5px 0;
  }
  a.foot-col-link:hover {
    color: var(--cs-accent-2);
  }
  .foot-col-link.soon {
    color: var(--cs-text-3);
    cursor: default;
  }
  .foot-col-link svg {
    width: 11px;
    height: 11px;
    opacity: 0.7;
  }

  /* Responsive */
  @media (max-width: 48rem) {
    .hero {
      padding: 80px 18px 70px;
    }
    h1 {
      font-size: 42px;
      letter-spacing: -0.03em;
    }
    .lead {
      font-size: 16px;
    }
    .skills {
      padding: 56px 18px;
    }
    .foot-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
