---
/**
 * SkillSwitcher — top-bar dropdown listing every Cody Skill.
 *
 * Reads `skills` from `src/skills/index.ts`. The skill matching the current
 * URL prefix (/docs/<id>/...) is rendered as the button label and gets a check
 * mark in the open menu. Clicking another skill navigates to that skill's
 * Overview at `/docs/<id>/`.
 */
import { skills, getSkillIconLetter } from '../skills';
import { getActiveSkill } from '../skills/active';

const active = getActiveSkill(Astro.url.pathname);
---

<div class="skill-switcher">
  <button
    class="ss-trigger"
    id="skill-switcher-trigger"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={`Current skill: ${active.name}. Click to switch.`}
  >
    <span class="ss-dot" aria-hidden="true"></span>
    <span class="ss-name">{active.name}</span>
    <svg
      class="ss-chev"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      width="12"
      height="12"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>

  <div class="ss-menu" id="skill-switcher-menu" role="listbox">
    <div class="ss-label">Switch skill</div>
    {
      skills.map((s) =>
        s.status === 'available' ? (
          <a
            class:list={['ss-item', { active: s.id === active.id }]}
            href={`/docs/${s.id}/`}
            role="option"
            aria-selected={s.id === active.id}
          >
            <span class="ss-item-ico" aria-hidden="true">
              {getSkillIconLetter(s)}
            </span>
            <span class="ss-item-text">
              <span class="ss-item-name">{s.name}</span>
              <span class="ss-item-ver">v{s.version}</span>
            </span>
            <svg
              class="ss-item-check"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              width="14"
              height="14"
            >
              <path d="M5 13l4 4L19 7" />
            </svg>
          </a>
        ) : (
          <div class="ss-item soon" role="option" aria-disabled="true">
            <span class="ss-item-ico" aria-hidden="true">
              {getSkillIconLetter(s)}
            </span>
            <span class="ss-item-text">
              <span class="ss-item-name">{s.name}</span>
              <span class="ss-item-ver">Coming soon</span>
            </span>
          </div>
        )
      )
    }
  </div>
</div>

<script>
  // Toggle the skill switcher dropdown.
  const wrap = document.querySelector('.skill-switcher') as HTMLElement | null;
  const trigger = document.getElementById('skill-switcher-trigger');
  if (wrap && trigger) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = wrap.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', () => {
      wrap.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        wrap.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .skill-switcher {
    position: relative;
  }

  .ss-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: var(--cs-fw-semibold);
    cursor: pointer;
    line-height: 1;
  }
  .ss-trigger:hover {
    filter: brightness(1.1);
  }

  .ss-dot {
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: 0.3125rem;
    background: var(--sl-color-accent);
    flex-shrink: 0;
  }
  .ss-chev {
    opacity: 0.6;
    transition: transform 0.15s;
    flex-shrink: 0;
  }
  .skill-switcher.open .ss-chev {
    transform: rotate(180deg);
  }

  .ss-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    min-width: 18rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 0.375rem;
    z-index: 50;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
    display: none;
  }
  .skill-switcher.open .ss-menu {
    display: block;
  }

  .ss-label {
    font-size: var(--sl-text-2xs);
    font-weight: var(--cs-fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--cs-tracking-widest);
    color: var(--sl-color-gray-3);
    padding: 0.5rem 0.625rem 0.3125rem;
  }

  .ss-item {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    padding: 0.5625rem 0.625rem;
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .ss-item:hover {
    background: var(--sl-color-gray-6);
  }

  .ss-item-ico {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    flex-shrink: 0;
  }

  .ss-item-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .ss-item-name {
    font-size: var(--sl-text-sm);
    font-weight: var(--cs-fw-semibold);
  }
  .ss-item-ver {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .ss-item-check {
    color: var(--sl-color-accent);
    opacity: 0;
    flex-shrink: 0;
  }
  .ss-item.active .ss-item-check {
    opacity: 1;
  }

  /* Coming-soon entries — visible but non-interactive. */
  .ss-item.soon {
    opacity: 0.55;
    cursor: default;
  }
  .ss-item.soon:hover {
    background: transparent;
  }
  .ss-item.soon .ss-item-ico {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
  .ss-item.soon .ss-item-ver {
    color: var(--sl-color-gray-3);
  }

  /* At ≤48rem (768px), shrink the trigger to a green dot pill — matches the
     prototype's mobile pattern. The dropdown menu still works on tap. */
  @media (max-width: 48rem) {
    .ss-name,
    .ss-chev {
      display: none;
    }
    .ss-trigger {
      padding: 0.4375rem 0.625rem;
      gap: 0;
    }
  }
</style>
