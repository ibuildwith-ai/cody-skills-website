---
/**
 * Custom Header — overrides Starlight's default top bar to lay out:
 *
 *   LEFT:   brand · SkillSwitcher · GetSkillMenu  (contextual to the active skill)
 *   RIGHT:  Search · GitHubLink · ThemeSelect      (global affordances)
 *
 * Starlight's per-page `Search` and `ThemeSelect` are still used (via the virtual
 * imports) so site-wide search and the existing light/dark toggle keep working.
 */
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import config from 'virtual:starlight/user-config';

import SkillSwitcher from './SkillSwitcher.astro';
import GetSkillMenu from './GetSkillMenu.astro';
import GitHubLink from './GitHubLink.astro';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <a href="/" class="brand" aria-label="Cody Skills home">
    <img
      class="brand-logo"
      src="/images/cody-skills-logo.png"
      alt=""
      aria-hidden="true"
    />
    <span class="brand-text">Cody Skills</span>
  </a>

  <SkillSwitcher />
  <GetSkillMenu />

  <div class="spacer"></div>

  {shouldRenderSearch && <div class="search-slot print:hidden"><Search /></div>}

  <div class="right-group sl-hidden md:sl-flex print:hidden">
    <GitHubLink />
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      gap: 1rem; /* 16px — matches prototype's topbar gap */
      height: 100%;
    }

    /* Brand — robot logo + "Cody Skills" wordmark. The PNG works on both
       themes (green/black robot on a green-ring black circle), so we don't
       need to swap it for light mode. The wordmark uses the topbar text color
       and inverts automatically in light mode.

       `margin-inline-end` (~12px) adds a deliberate visual gap between the
       brand and the SkillSwitcher next to it, on top of the 1rem `.header`
       gap. Comes out to ~28px total, matching the marketing landing's nav
       spacing. */
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5625rem;
      margin-inline-end: 0.75rem;
      font-weight: var(--cs-fw-bold);
      font-size: var(--sl-text-base);
      letter-spacing: var(--cs-tracking-tight);
      color: var(--sl-color-white);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
    .brand-logo {
      display: block;
      width: 1.625rem; /* 26px — matches the marketing landing */
      height: 1.625rem;
      flex-shrink: 0;
    }

    /* Spacer takes all available middle space */
    .spacer {
      flex: 1;
    }

    /* Search slot — capped width on desktop so the row stays balanced */
    .search-slot {
      max-width: 16rem;
      flex: 0 1 16rem;
    }

    .right-group {
      gap: 0.5rem;
      align-items: center;
    }

    /* ---------- Responsive compression ---------- */

    /* Hide the wordmark on small screens (logo stays) */
    @media (max-width: 48rem) {
      .brand-text {
        display: none;
      }
    }
  }
</style>
