---
/**
 * SkillCard — full-width row on the marketing landing.
 *
 * Layout: illustration on one side, content (status pill + name + tagline + CTA)
 * on the other. Pass `reverse: true` to flip the illustration to the right side;
 * the landing alternates rows for visual rhythm.
 *
 * Status drives everything else:
 *   - `'available'`: card is a link to /docs/<id>/, status pill shows the
 *     current version + "Available now", CTA is "Get the skill →".
 *   - `'coming-soon'`: card itself is non-interactive but the CTA is a
 *     "Notify me →" mailto with the skill name pre-filled so the visitor
 *     can register interest. The pill at the top still says "Coming soon".
 */
import type { Skill } from '../skills';
import { CONTACT_EMAIL } from '../site-config';

interface Props {
  skill: Skill;
  /** Flip illustration to the right side (for alternating-row rhythm). */
  reverse?: boolean;
}

const { skill, reverse = false } = Astro.props;
const isAvailable = skill.status === 'available';
const href = isAvailable ? `/docs/${skill.id}/` : undefined;
const Tag = isAvailable ? 'a' : 'div';

/** Pre-filled mailto for the coming-soon CTA. */
const notifyHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(
  `Notify me when ${skill.name} is available`
)}`;
---

<Tag
  class:list={['skill-row', isAvailable ? 'live' : 'soon', { reverse }]}
  href={href}
>
  <div class="skill-illust">
    <img src={skill.illustration} alt="" loading="lazy" />
  </div>
  <div class="skill-content">
    <span class="skill-status">
      {isAvailable ? `v${skill.version} · Available now` : 'Coming soon'}
    </span>
    <h2 class="skill-title">{skill.name}</h2>
    <p class="skill-body">{skill.tagline}</p>
    {
      isAvailable ? (
        <span class="skill-cta">
          Get the skill
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </span>
      ) : (
        <a class="skill-cta notify" href={notifyHref}>
          Notify me
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      )
    }
  </div>
</Tag>

<style>
  .skill-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    background: var(--cs-bg-card, #181818);
    border: 1px solid var(--cs-border, #2a2a2a);
    border-radius: 18px;
    padding: 36px;
    text-decoration: none;
    color: inherit;
    transition: 0.2s;
    overflow: hidden;
  }
  /* Gradient hover border (live cards only) — same as the prototype */
  .skill-row::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0) 0%, rgba(34, 197, 94, 0.5) 100%);
    -webkit-mask:
      linear-gradient(#000, #000) content-box,
      linear-gradient(#000, #000);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: 0.2s;
    pointer-events: none;
  }
  .skill-row.live:hover {
    transform: translateY(-2px);
  }
  .skill-row.live:hover::before {
    opacity: 1;
  }
  .skill-row.soon {
    opacity: 0.66;
    cursor: default;
  }

  /* Flip — illustration on the right, content on the left. */
  .skill-row.reverse .skill-illust {
    order: 2;
  }
  .skill-row.reverse .skill-content {
    order: 1;
  }

  .skill-illust {
    display: block;
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--cs-border, #2a2a2a);
    overflow: hidden;
  }
  .skill-illust img {
    display: block;
    width: 100%;
    height: auto;
  }

  .skill-content {
    display: flex;
    flex-direction: column;
  }

  .skill-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--cs-border, #2a2a2a);
    width: fit-content;
    margin-bottom: 18px;
  }
  .skill-row.live .skill-status {
    color: var(--cs-accent-2, #4ade80);
  }
  .skill-row.live .skill-status::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cs-accent, #22c55e);
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
  }
  .skill-row.soon .skill-status {
    color: var(--cs-text-3, #888);
  }

  .skill-title {
    font-size: 28px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    line-height: 1.15;
  }
  .skill-body {
    font-size: 15.5px;
    color: var(--cs-text-2, #b0b0b0);
    line-height: 1.6;
    margin: 0 0 22px;
  }

  .skill-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 650;
    color: var(--cs-accent-2, #4ade80);
    text-decoration: none;
    width: fit-content;
  }
  .skill-cta svg {
    width: 14px;
    height: 14px;
    transition: transform 0.15s;
  }
  .skill-row.live:hover .skill-cta svg {
    transform: translateX(3px);
  }
  /* Coming-soon Notify-me CTA — keeps the accent color so the link reads as
     interactive, with a hover effect mirroring the live cards. The parent
     row stays slightly dimmed via its own opacity, which softens this too. */
  .skill-cta.notify:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 48rem) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    /* On mobile, illustration always on top regardless of `reverse`. */
    .skill-row.reverse .skill-illust {
      order: 1;
    }
    .skill-row.reverse .skill-content {
      order: 2;
    }
    .skill-title {
      font-size: 22px;
    }
    .skill-body {
      font-size: 14.5px;
    }
  }
</style>
