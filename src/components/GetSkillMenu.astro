---
/**
 * GetSkillMenu — green "Get Skill" button + per-skill download dropdown.
 *
 * Renders the active skill's `getSkill[]` entries. Each entry has an icon
 * (zipper-file for `.zip`, lightning bolt for `.skill`), a name, and an
 * optional description. The button itself shows a download arrow icon
 * (no chevron — confirmed in the prototype design).
 */
import { getActiveSkill } from '../skills/active';

const active = getActiveSkill(Astro.url.pathname);
const items = active.getSkill;
---

<div class="get-skill">
  <button
    class="gs-trigger"
    id="get-skill-trigger"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={`Get ${active.name}`}
  >
    <svg
      class="gs-dl"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      width="14"
      height="14"
    >
      <path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" />
    </svg>
    <span class="gs-label">Get Skill</span>
  </button>

  <div class="gs-menu" id="get-skill-menu" role="menu">
    <div class="gs-heading">Get {active.name}</div>
    {
      items.map((item) => (
        <a class="gs-item" href={item.href} role="menuitem">
          <span class="gs-ico" aria-hidden="true">
            {item.icon === 'zip' ? (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="17"
                height="17"
              >
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <polyline points="14 3 14 8 19 8" />
                <path d="M11 12l1.5 1.5L11 15l1.5 1.5L11 18" />
              </svg>
            ) : (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                width="17"
                height="17"
              >
                <path d="M13 3 L5 13.5 L11.5 13.5 L11 21 L19 10.5 L12.5 10.5 L13 3 Z" />
              </svg>
            )}
          </span>
          <span class="gs-text">
            <span class="gs-name">{item.name}</span>
            {item.description && (
              <span class="gs-desc">{item.description}</span>
            )}
          </span>
        </a>
      ))
    }
  </div>
</div>

<script>
  const wrap = document.querySelector('.get-skill') as HTMLElement | null;
  const trigger = document.getElementById('get-skill-trigger');
  const menu = document.getElementById('get-skill-menu');
  if (wrap && trigger && menu) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = wrap.classList.toggle('open');
      trigger.setAttribute('aria-expanded', String(open));
    });
    menu.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => {
      wrap.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        wrap.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .get-skill {
    position: relative;
  }

  .gs-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
    border: 0;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: var(--cs-fw-button);
    letter-spacing: 0.005em;
    cursor: pointer;
    line-height: 1.15;
  }
  .gs-trigger:hover {
    filter: brightness(1.08);
  }
  .gs-dl {
    flex-shrink: 0;
  }

  .gs-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    min-width: 15rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    padding: 0.375rem;
    z-index: 50;
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.4);
    display: none;
  }
  .get-skill.open .gs-menu {
    display: block;
  }

  .gs-heading {
    font-size: var(--sl-text-2xs);
    font-weight: var(--cs-fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--cs-tracking-widest);
    color: var(--sl-color-gray-3);
    padding: 0.5625rem 0.625rem 0.3125rem;
  }

  .gs-item {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    padding: 0.5625rem 0.625rem;
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .gs-item:hover {
    background: var(--sl-color-gray-6);
  }

  .gs-ico {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gs-text {
    display: flex;
    flex-direction: column;
  }
  .gs-name {
    font-size: var(--sl-text-sm);
    font-weight: var(--cs-fw-semibold);
  }
  .gs-desc {
    font-size: var(--cs-text-badge);
    color: var(--sl-color-gray-3);
    margin-top: 0.0625rem;
  }
</style>
