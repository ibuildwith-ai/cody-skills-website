---
/**
 * Breadcrumb — small lineage at the top of each content page.
 *
 * Example: "Cody Product Builder / Getting Started / Overview"
 *
 * Derived from the active skill (URL prefix) + sidebar metadata:
 *   - the skill's display name
 *   - the sidebar group whose items contain the current page
 *   - the current page's sidebar label (falls back to frontmatter title)
 */
import { getActiveSkill } from '../skills/active';

const active = getActiveSkill(Astro.url.pathname);
const pathname = Astro.url.pathname.replace(/\/$/, '');

// The page slug relative to the skill, e.g. 'getting-started/installation' or
// '' (empty string) when the reader is on the skill's Overview.
const skillPrefix = `/docs/${active.id}`;
const relSlug = pathname.startsWith(skillPrefix)
  ? pathname.slice(skillPrefix.length).replace(/^\//, '')
  : '';

// Find which sidebar group contains the active item.
let groupLabel: string | undefined;
let itemLabel: string | undefined;
for (const group of active.sidebar) {
  const item = group.items.find((i) => i.slug === relSlug);
  if (item) {
    groupLabel = group.label;
    itemLabel = item.label;
    break;
  }
}

// Fall back to the frontmatter title for pages not in the sidebar.
const fallbackTitle =
  (Astro.locals.starlightRoute?.entry?.data as { title?: string } | undefined)
    ?.title ?? '';
const pageLabel = itemLabel ?? fallbackTitle;
---

<nav class="crumb" aria-label="Breadcrumb">
  <a href={`/docs/${active.id}/`}>{active.name}</a>
  {
    groupLabel && (
      <>
        <span class="sep" aria-hidden="true">
          /
        </span>
        <span>{groupLabel}</span>
      </>
    )
  }
  {
    pageLabel && (
      <>
        <span class="sep" aria-hidden="true">
          /
        </span>
        <span>{pageLabel}</span>
      </>
    )
  }
</nav>

<style>
  .crumb {
    font-size: var(--cs-text-crumb);
    color: var(--sl-color-gray-3);
    margin-bottom: 0.875rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .crumb a {
    color: inherit;
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--sl-color-text);
  }
  .crumb .sep {
    opacity: 0.5;
  }
</style>
